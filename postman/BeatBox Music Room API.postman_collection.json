      "name": "Invalid musician validation",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400 Bad Request', function () { pm.response.to.have.status(400); });", "pm.test('JSON error is present', function () { pm.expect(pm.response.json().error).to.be.a('string'); });"] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/musicians" } }
    },
