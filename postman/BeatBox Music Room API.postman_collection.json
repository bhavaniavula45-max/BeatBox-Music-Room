      "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Casio Privia Keyboard\",\n  \"family\": \"Keyboard\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/instruments/{{instrumentId4}}" } }
    },
    {
      "name": "Delete instrument",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 204 No Content', function () { pm.response.to.have.status(204); });"] } }],
      "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/api/instruments/{{instrumentId4}}" } }
    },
