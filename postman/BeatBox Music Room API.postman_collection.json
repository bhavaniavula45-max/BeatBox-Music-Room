      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400 Bad Request', function () { pm.response.to.have.status(400); });"] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Invalid Status Instrument\",\n  \"family\": \"Strings\",\n  \"status\": \"broken\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/instruments" } }
    },
